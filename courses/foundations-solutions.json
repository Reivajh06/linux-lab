{
  "find-your-feet": "printf '/home/learner\\n' > /home/learner/lab/home-path.txt",
  "make-directories": "mkdir -p /home/learner/lab/project/{src,docs}",
  "copy-and-move": "cp /home/learner/lab/inputs/message.txt /home/learner/lab/copied.txt; cp /home/learner/lab/inputs/message.txt /home/learner/lab/temporary.txt; mv /home/learner/lab/temporary.txt /home/learner/lab/renamed.txt",
  "remove-safely": "rm /home/learner/lab/cleanup/obsolete.txt",
  "hidden-files": "printf 'theme=green\\n' > /home/learner/lab/.practice-config",
  "links": "ln -s /home/learner/lab/inputs/message.txt /home/learner/lab/message-link",
  "read-manuals": "printf 'man ls; info coreutils; help cd\\n' > /home/learner/lab/manuals.txt",
  "editor-vi": "printf 'Learning with vi\\n' > /home/learner/lab/vi-note.txt",
  "editor-vim": "printf 'Learning with vim\\n' > /home/learner/lab/vim-note.txt",
  "editor-nano": "printf 'Learning with nano\\n' > /home/learner/lab/nano-note.txt",
  "editor-gedit": "printf 'Learning with gedit\\n' > /home/learner/lab/gedit-note.txt",
  "grep-logs": "grep ERROR /home/learner/lab/inputs/app.log > /home/learner/lab/errors.log",
  "sort-and-count": "sort -u /home/learner/lab/inputs/fruit.txt > /home/learner/lab/unique-fruit.txt; wc -l < /home/learner/lab/unique-fruit.txt > /home/learner/lab/fruit-count.txt",
  "replace-text": "sed 's/old/new/g' /home/learner/lab/inputs/settings.txt > /home/learner/lab/settings.txt",
  "find-files": "find /home/learner/lab/inputs -name '*.txt' > /home/learner/lab/found-files.txt",
  "private-file": "touch /home/learner/lab/private.txt; chmod 600 /home/learner/lab/private.txt",
  "shared-directory": "mkdir -p /home/learner/lab/shared; chmod 2770 /home/learner/lab/shared",
  "create-user": "sudo useradd -m -s /bin/bash labalex",
  "create-group": "sudo groupadd labteam",
  "group-membership": "sudo usermod -aG labpractice labmember",
  "file-ownership": "touch /home/learner/lab/owned.txt; sudo chown learner:labowners /home/learner/lab/owned.txt",
  "remove-user": "sudo userdel -r labtemporary",
  "process-snapshot": "ps aux > /home/learner/lab/processes.txt",
  "background-job": "nohup sleep 600 >/tmp/lab-sleep.log 2>&1 &",
  "network-interfaces": "ip address > /home/learner/lab/interfaces.txt",
  "local-hostname": "hostname > /home/learner/lab/hostname.txt",
  "package-inventory": "dpkg-query -W nano > /home/learner/lab/package-info.txt",
  "archive": "tar -czf /home/learner/lab/notes.tar.gz -C /home/learner/lab/inputs message.txt",
  "first-script": "printf %s '#!/bin/bash\nprintf \"Hello, Linux!\\n\"\n' > /home/learner/lab/greet.sh; chmod 755 /home/learner/lab/greet.sh",
  "script-arguments": "printf %s '#!/bin/bash\nprintf \"Welcome, %s\\n\" \"$1\"\n' > /home/learner/lab/welcome.sh"
}