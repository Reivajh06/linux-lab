#!/bin/bash
export DISPLAY=:1
export GTK_THEME=Adwaita:dark
export LANG=${LANG:-en_US.UTF-8}
export XDG_RUNTIME_DIR=/tmp/runtime-learner
if [ -f /tmp/linux-lab-session-bus ]; then
    export DBUS_SESSION_BUS_ADDRESS="$(cat /tmp/linux-lab-session-bus)"
fi
cd /home/learner
# Fedora's GNOME Terminal; --wait keeps this launcher alive while the window is open.
if command -v gnome-terminal >/dev/null; then
    exec gnome-terminal --wait --window --working-directory=/home/learner
fi
# Environments from older lab images only have xfce4-terminal.
exec xfce4-terminal --disable-server --show-menubar --hide-borders --show-scrollbar --title=Terminal --working-directory=/home/learner --command="bash -l"
